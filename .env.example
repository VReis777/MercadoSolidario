# ============================================
# MERCADO SOLIDÁRIO - Environment Variables
# ============================================

# Database Configuration
DATABASE_URL=jdbc:postgresql://localhost:5432/mercado_solidario
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres

# JWT Configuration
JWT_SECRET=your-secret-key-change-in-production-minimum-256-bits-long
JWT_EXPIRATION=86400000

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Server Configuration
SERVER_PORT=8080

# Logging
LOG_LEVEL=INFO
SECURITY_LOG_LEVEL=INFO

# Swagger/OpenAPI
SWAGGER_ENABLED=true

# Initial Admin Setup (DO NOT ENABLE IN PRODUCTION)
# Set to true ONLY for initial setup, then set to false
INITIAL_ADMIN_ENABLED=false
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=change-this-password
INITIAL_ADMIN_FULL_NAME=Administrador

# Production settings (change these in production)
# APP_BASE_URL=https://your-domain.com
# FRONTEND_URL=https://your-domain.com
# BACKEND_URL=https://api.your-domain.com

# SMTP Configuration (Gmail)
# Configure MAIL_PASSWORD as an environment variable for security
# DO NOT commit the actual password to Git
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=mevammercadosolidario@gmail.com
MAIL_PASSWORD=YOUR_GMAIL_APP_PASSWORD_HERE
MAIL_ENABLED=true
APP_FRONTEND_BASE_URL=http://localhost:5173
